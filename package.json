{
  "name": "assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "vite build --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "build:obsidian": "mkdir -p dist/obsidian && cp obsidian/main.js obsidian/manifest.json dist/obsidian/"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^11.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
